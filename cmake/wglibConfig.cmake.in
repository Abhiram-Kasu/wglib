@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if("@WGLIB_INSTALL_STATIC_PACKAGE@")
    find_dependency(Threads)
    if("@WGLIB_STATIC_PACKAGE_REQUIRES_X11@")
        find_dependency(X11)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/wglibTargets.cmake")

set(wglib_SHADER_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/wglib/shaders")
check_required_components(wglib)
